<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="RealtimeSubtitle.Overlay.Wpf.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealtimeSubtitle Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="1200" Height="170"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- 逐像素透明（WPF AllowsTransparency → UpdateLayeredWindow）：只有字幕条区域有内容，
         其余像素 alpha=0 完全透出桌面/游戏。WinUI 3 窗口无逐像素 alpha（decisions P4-1）。 -->
    <Grid>
        <Border x:Name="Root" Background="#CC101010" CornerRadius="8" Padding="20,10"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1400">
            <StackPanel>
                <TextBlock x:Name="Line1" FontSize="32" FontWeight="SemiBold" Foreground="White"
                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="Line2" FontSize="20" Foreground="#E0FFFFFF"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
